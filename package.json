    "jest": "29.0.0",
    "supertest": "7.2.2"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "dotenv": "17.4.2",
    "express": "4.22.2",
    "express-rate-limit": "8.6.2",
    "jsonwebtoken": "9.0.0",
    "mongodb": "7.1.0",
    "nodemailer": "9.0.4"
  }
